{
  "name": "echoworld",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ECHO_ROOM",
        "class_name": "EchoRoomDO"
      },
      {
        "name": "ECHO_LOBBY",
        "class_name": "EchoLobbyDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EchoRoomDO", "EchoLobbyDO"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "*"
  }
}
